NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# Stripe — required for All White Party checkout (/all-white-party)
# Get this from https://dashboard.stripe.com/apikeys (use sk_test_... until going live)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe webhook signing secret — issues e-tickets after payment.
# Create a webhook at https://dashboard.stripe.com/webhooks pointing to
# https://mytampapulse.com/api/awp-stripe-webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Door staff PIN for checking in tickets at /all-white-party/ticket/[code]
AWP_DOOR_PIN=

# Optional — enables the exterior Street View photo on /all-white-party.
# Create a key at https://console.cloud.google.com/google/maps-apis/credentials
# and enable the "Street View Static API". Without it, the page shows the aerial map only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
